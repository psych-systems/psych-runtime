# Any compatible chat-completions endpoint, including a local gateway or a
# hosted provider. Psych speaks the wire protocol rather than
# depending on a provider SDK.
OPENAI_API_KEY=
PSYCH_BASE_URL=https://api.openai.com/v1
PSYCH_MODEL=gpt-4o-mini

# Unset: main.py hosts a Worker itself and Runs live in memory (development).
# Set: run main.py and worker.py separately, and Runs survive a restart.
# PSYCH_POSTGRES_DSN=postgresql://localhost/psych
# PSYCH_CONCURRENCY=8
